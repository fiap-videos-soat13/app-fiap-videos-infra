# Copy to terraform.tfvars and edit before apply.
# For credit-conscious staging, see terraform.tfvars.free-tier.example

aws_region  = "us-east-2"
environment = "staging"

project_name               = "fiap-videos"
k8s_service_account_prefix = "staging-"

# Free-tier friendly EKS sizing (~$90-110/month with 1 node; EKS control plane is ~$73/month)
eks_node_instance_types = ["t3.small"]
eks_node_desired_size   = 1
eks_node_min_size       = 1
eks_node_max_size       = 2

# RDS Free Tier (750 hours/month for 12 months on new accounts)
db_instance_class         = "db.t3.micro"
db_allocated_storage_gb   = 20

# In-cluster messaging/cache (deploy RabbitMQ + Redis in the staging overlay)
in_cluster_rabbitmq_url = "amqp://fiap:fiap@rabbitmq.fiap-videos.svc:5672/"
in_cluster_redis_url    = "redis://redis.fiap-videos.svc:6379"
